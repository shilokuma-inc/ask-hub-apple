{
  "description": "ビルドの設定を入れる人の意図の payload の例。read は、封筒の repo があり target と targetVersion が無いときに、読む側がビルドの設定を入れる意図として読めるか。build の中の知らない欄も、一部だけを設定として扱わないよう読まない（スキーマと同じ）",
  "schema": "payloads/configureRepository.schema.json",
  "cases": [
    {
      "name": "full",
      "payload": {
        "build": {
          "baseBranch": "main",
          "xcode": {
            "project": "App/App.xcodeproj",
            "scheme": "App",
            "destinations": [
              {
                "platform": "iOS",
                "deviceType": "iPhone 17 Pro",
                "osVersion": "26.5"
              },
              {
                "platform": "macOS"
              }
            ],
            "testLight": {
              "onlyTesting": [
                "AppTests"
              ]
            },
            "testFull": {
              "testPlan": "Full"
            }
          },
          "childChecks": [
            "build / build"
          ],
          "finalChecks": [
            "build / build",
            "ui-test / ui-test"
          ],
          "trustedReviewers": [
            "coderabbitai[bot]"
          ],
          "screenshots": {
            "scenes": "App/screenshot-scenes.json",
            "destination": {
              "platform": "iOS",
              "deviceType": "iPhone 17 Pro",
              "osVersion": "27.0"
            }
          }
        }
      },
      "schemaValid": true,
      "read": "valid"
    },
