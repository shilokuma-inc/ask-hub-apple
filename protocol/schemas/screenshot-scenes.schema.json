{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shilokuma-inc/ask-hub-apple/protocol/schemas/screenshot-scenes.schema.json",
  "title": "撮れる画面の一覧（対象のリポジトリに置くファイル。repo.json の build.screenshots.scenes が指す）",
  "description": "ワーカーが、画面ごとの起動引数でアプリを Simulator に起動して撮る。実装した Claude が見た目を変えた画面・状態を足し、判断の仕分けの Claude が見える仮決めごとに 1 つ選ぶ。撮った画像は public の最終 PR に載るので、デモのデータの画面だけを書く。id の重複は読む側で確かめる",
  "type": "object",
  "required": ["v", "scenes"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "title", "arguments"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
            "description": "画面の名前。状態リポジトリのファイル名にも使う"
          },
          "title": { "$ref": "#/$defs/text", "description": "何の画面・状態か（人と Claude が読む）" },
          "arguments": {
            "type": "array",
            "maxItems": 30,
            "items": { "$ref": "#/$defs/text" },
            "description": "その画面をデモのデータで開く起動引数（simctl launch でアプリに渡す。シェルは通さない）"
          }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 300, "not": { "pattern": "[\\u0000-\\u001f\\u007f]" } }
  }
}
