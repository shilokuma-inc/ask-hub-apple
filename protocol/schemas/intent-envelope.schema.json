{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shilokuma-inc/ask-hub-apple/protocol/schemas/intent-envelope.schema.json",
  "title": "人の意図の封筒",
  "description": "docs/renewal/protocol.md の「封筒」。RFC 8785 でそろえた UTF-8 のバイト列に、ECDSA P-256・SHA-256 で署名する",
  "type": "object",
  "required": ["v", "kind", "issuedAt", "nonce", "keyId"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "request", "answer", "startEpic", "reviseGoal", "decideSplit", "decision", "approveMerge", "instructFinal", "humanTaskDone",
        "pauseEpic", "resumeEpic", "handover", "retry", "giveUp", "abandonEpic", "verify", "addRepository", "removeRepository", "applyProtection",
        "registerKey", "revokeKey"
      ]
    },
    "repo": { "$ref": "common.schema.json#/$defs/repositoryFullName" },
    "target": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "epic": { "$ref": "common.schema.json#/$defs/ulid" },
        "id": { "type": "string" }
      }
    },
    "targetVersion": { "type": "string" },
    "bodySha256": { "$ref": "common.schema.json#/$defs/sha256Hex" },
    "payload": { "type": "object", "additionalProperties": { "$ref": "json-value.schema.json" } },
    "issuedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "nonce": { "$ref": "common.schema.json#/$defs/ulid", "description": "一度しか使えない番号。処理した記録（consumed/<keyId>/<nonce>）のパスに使う" },
    "keyId": { "$ref": "common.schema.json#/$defs/keyId" }
  }
}
