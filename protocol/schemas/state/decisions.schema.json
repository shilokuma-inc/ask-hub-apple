{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shilokuma-inc/ask-hub-apple/protocol/schemas/state/decisions.schema.json",
  "title": "repos/<owner>/<repo>/epics/<epic>/decisions.json（人が決めていない判断）",
  "description": "司令塔だけが書く。ループの仮決め（実装した Claude が報告したもの）をタスクごとに足す。id の重複・task の形・スクショと答えは見える仮決めだけが持つこと・スクショのパスは読む側で確かめる",
  "type": "object",
  "required": [
    "v",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "what",
          "why",
          "alternatives"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "../common.schema.json#/$defs/localId"
          },
          "task": {
            "anyOf": [{ "$ref": "../common.schema.json#/$defs/localId" }, { "type": "null" }],
            "description": "どのタスクの仮決めか（ゴールのタスクの id）。最終 PR の直しの仮決めはタスクに結びつかないので null か省く"
          },
          "pullRequest": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "仮決めを含む子 PR"
          },
          "visible": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "見える（挙動・仕様・見た目に関わる）か。仕分ける前は null"
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "description": "なぜ（ゴールのどの項目から来たか）"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scene": {
            "anyOf": [{ "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" }, { "type": "null" }],
            "description": "撮る画面（リポジトリの撮れる画面の一覧の id）。判断の仕分けの Claude が見える仮決めごとに選ぶ。合う画面が無ければ null"
          },
          "screenshots": {
            "anyOf": [{ "$ref": "#/$defs/screenshots" }, { "type": "null" }],
            "description": "見える仮決めの Before / After（撮影のジョブが撮ったもの）。撮る前は null"
          },
          "answer": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "choice",
                  "note",
                  "intent",
                  "at"
                ],
                "additionalProperties": false,
                "properties": {
                  "choice": {
                    "enum": [
                      "ok",
                      "alternative",
                      "fix"
                    ]
                  },
                  "note": {
                    "type": "string"
                  },
                  "intent": {
                    "$ref": "../common.schema.json#/$defs/intentReference"
                  },
                  "at": {
                    "$ref": "../common.schema.json#/$defs/timestamp"
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "人の答え（判断のカード）。見える仮決めだけが持つ"
          }
        }
      }
    }
  },
  "$defs": {
    "screenshots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before": {
          "anyOf": [{ "type": "string", "pattern": "^repos/.*/screenshots/.*\\.png$" }, { "type": "null" }],
          "description": "Before（base との分岐点）の画像。状態リポジトリの中のパス（epic の screenshots/ の下。.. を含まないことは読む側で確かめる）"
        },
        "after": {
          "anyOf": [{ "type": "string", "pattern": "^repos/.*/screenshots/.*\\.png$" }, { "type": "null" }],
          "description": "After（作業ブランチの先頭）の画像"
        },
        "beforeURL": {
          "anyOf": [{ "type": "string", "pattern": "^https://github\\.com/user-attachments/assets/[A-Za-z0-9-]{1,100}$" }, { "type": "null" }],
          "description": "GitHub に上げた Before の画像（最終 PR の本文に載せる）。上げられなかったら null"
        },
        "afterURL": {
          "anyOf": [{ "type": "string", "pattern": "^https://github\\.com/user-attachments/assets/[A-Za-z0-9-]{1,100}$" }, { "type": "null" }]
        },
        "head": {
          "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40 }, { "type": "null" }],
          "description": "After を撮ったコミット（作業ブランチの先頭）"
        },
        "note": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 500 }, { "type": "null" }],
          "description": "撮れなかったわけ・Before が無いわけ（人が読む）"
        }
      }
    }
  }
}
