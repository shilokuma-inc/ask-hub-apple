{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shilokuma-inc/ask-hub-apple/protocol/schemas/state/submission.schema.json",
  "title": "repos/<owner>/<repo>/submissions/<版>.json（リリースを始めた版の準備と審査）",
  "description": "司令塔だけが書く。人が startRelease を押したときに作り（origin が askhub）、release ブランチ・develop の版を上げる PR・What's New の下書き・掲載文の案・release ブランチから上げたビルドを足す。人が submitForReview（targetVersion は revision）を押すと司令塔が App Store Connect に出し、審査の状態をプラットフォームごとに review に書く。App Store Connect の Web で手で出した版を見つけたときも作る（origin が appStoreConnect。準備の欄を持たない）。配信を見つけたら end を付ける。欄どうしの決まり（origin ごとの欄・branch の name が release/<版>・次の版は始めた版より大きい・earliestReleaseDate は scheduled のときだけ・end の approval は abandoned のときだけ・言語とプラットフォームを重ねない など）は読む側で確かめる",
  "type": "object",
  "required": [
    "v",
    "repo",
    "version",
    "origin",
    "builds",
    "revision",
    "review",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "localizedTexts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "locale",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8}){0,2}$",
            "maxLength": 21,
            "description": "App Store Connect の言語（ja・en-US・zh-Hans など）"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "buildChoice": {
      "type": "object",
      "required": [
        "platform",
        "build"
      ],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "$ref": "release.schema.json#/$defs/platform"
        },
        "build": {
          "$ref": "release.schema.json#/$defs/buildNumber"
        }
      }
    },
    "listingTexts": {
      "type": "array",
      "maxItems": 50,
      "description": "言語ごとの掲載文（appStoreVersionLocalizations の description・keywords・promotionalText）。直す案・人が確かめた直しでは、無い欄は変えない（変える欄の無い言語は置かない）。言語を重ねない・空白だけの文・長さ（キーワードは UTF-8 で 100 バイトまで、ほかはコードポイントで数える）は読む側で確かめる",
      "items": {
        "type": "object",
        "required": [
          "locale"
        ],
        "additionalProperties": false,
        "properties": {
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8}){0,2}$",
            "maxLength": 21,
            "description": "App Store Connect の言語（ja・en-US・zh-Hans など）"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "keywords": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "promotionalText": {
            "type": "string",
            "maxLength": 170
          }
        }
      }
    },
    "currentListingTexts": {
      "type": "array",
      "maxItems": 50,
      "description": "配信中の版の掲載文（App Store Connect から読んだもの。長さは確かめない）。無い欄は App Store Connect で空",
      "items": {
        "type": "object",
        "required": [
          "locale"
        ],
        "additionalProperties": false,
        "properties": {
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8}){0,2}$",
            "maxLength": 21,
            "description": "App Store Connect の言語（ja・en-US・zh-Hans など）"
          },
          "description": {
            "type": "string"
          },
          "keywords": {
            "type": "string"
          },
          "promotionalText": {
            "type": "string"
          }
        }
      }
    },
    "reviewInformation": {
      "type": "object",
      "additionalProperties": false,
      "description": "App Review の情報（appStoreReviewDetails の notes・demoAccountRequired・demoAccountName）。デモアカウントのパスワードと連絡先は持たない。直す案・人が確かめた直しでは、無い欄は変えない。notes は UTF-8 で 4,000 バイトまで（読む側で確かめる）",
      "properties": {
        "notes": {
          "type": "string",
          "maxLength": 4000
        },
        "demoAccountRequired": {
          "type": "boolean"
        },
        "demoAccountName": {
          "type": "string",
          "maxLength": 255
        }
      }
    },
    "screenshotDecision": {
      "type": "object",
      "required": [
        "commit",
        "keep"
      ],
      "additionalProperties": false,
      "description": "人が確かめたスクショ。commit は人が見た撮影のコミット、keep は前の App Store のままにする画面（差のある画面だけ）",
      "properties": {
        "commit": {
          "$ref": "release.schema.json#/$defs/commit"
        },
        "keep": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "required": [
              "displayType",
              "locale",
              "index"
            ],
            "additionalProperties": false,
            "properties": {
              "displayType": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,59}$",
                "maxLength": 60
              },
              "locale": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8}){0,2}$",
                "maxLength": 21
              },
              "index": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            }
          }
        }
      }
    },
    "rejection": {
      "type": "object",
      "description": "1 回の審査で断られたときの対処。submittedAt は断られた「審査に出す」の submit.at、platforms は断られたプラットフォーム、report は人が貼った理由（文と画像。画像の中身は attachments/<device>/<nonce>/<n>）、triage は Claude の直し方の案、failure は案を書けなかった理由、choice は人が選んだ直し方",
      "required": [
        "submittedAt",
        "platforms",
        "report"
      ],
      "additionalProperties": false,
      "properties": {
        "submittedAt": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "release.schema.json#/$defs/platform"
          }
        },
        "report": {
          "type": "object",
          "required": [
            "text",
            "attachments",
            "approval",
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 10000
            },
            "attachments": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": [
                  "n",
                  "name",
                  "size",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "n": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 52428800
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            },
            "approval": {
              "$ref": "../common.schema.json#/$defs/intentReference"
            },
            "at": {
              "$ref": "../common.schema.json#/$defs/timestamp"
            }
          }
        },
        "triage": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "remedy",
                "summary",
                "plan",
                "draftedAt"
              ],
              "additionalProperties": false,
              "description": "Claude の直し方の案。remedy は勧める直し方、summary は理由の要約、plan は直し方の案、request は「このリリースを直す」依頼の下書き、listing・appReview の current は断られた版の今の文、whatsNew は直す What's New（変える言語だけ）、reply は App Review への返信の下書き",
              "properties": {
                "remedy": {
                  "enum": [
                    "code",
                    "metadata",
                    "reply"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "plan": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "request": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "title",
                        "body"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "body": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 20000
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "listing": {
                  "$ref": "#/properties/listing"
                },
                "whatsNew": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/localizedTexts"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "appReview": {
                  "$ref": "#/properties/appReview"
                },
                "reply": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "draftedAt": {
                  "$ref": "../common.schema.json#/$defs/timestamp"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "failure": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "choice": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "remedy",
                "approval",
                "at"
              ],
              "additionalProperties": false,
              "properties": {
                "remedy": {
                  "enum": [
                    "code",
                    "metadata",
                    "reply"
                  ]
                },
                "approval": {
                  "$ref": "../common.schema.json#/$defs/intentReference"
                },
                "at": {
                  "$ref": "../common.schema.json#/$defs/timestamp"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "creativeChoice": {
      "type": "object",
      "required": [
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "人が承認した案の版（creative.json の approved.revision）"
        }
      }
    }
  },
  "properties": {
    "v": {
      "const": 1
    },
    "repo": {
      "$ref": "../common.schema.json#/$defs/repositoryFullName"
    },
    "version": {
      "$ref": "release.schema.json#/$defs/marketingVersion"
    },
    "origin": {
      "enum": [
        "askhub",
        "appStoreConnect"
      ]
    },
    "start": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "approval",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "approval": {
          "$ref": "../common.schema.json#/$defs/intentReference"
        },
        "at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      },
      "description": "リリースを始めた人の意図（origin が askhub のときだけ）"
    },
    "hotfix": {
      "description": "hotfix（配信中の版だけを直す）の印。from は直す配信中の版（release ブランチはそのタグから作る）、suspended は一時停止した進行中のリリースの版",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "from"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "release.schema.json#/$defs/marketingVersion"
            },
            "suspended": {
              "anyOf": [
                {
                  "$ref": "release.schema.json#/$defs/marketingVersion"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "suspension": {
      "description": "hotfix の間の一時停止。by は hotfix の版、approval は hotfix を始めた人の意図、resumedAt は再開した時刻（一時停止の間は null）",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "by",
            "approval",
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "by": {
              "$ref": "release.schema.json#/$defs/marketingVersion"
            },
            "approval": {
              "$ref": "../common.schema.json#/$defs/intentReference"
            },
            "at": {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            "resumedAt": {
              "anyOf": [
                {
                  "$ref": "../common.schema.json#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "type": [
        "object",
        "null"
      ],
      "description": "release ブランチ。commit は作ったときの先頭（develop の先頭）。created は司令塔が作ったか",
      "required": [
        "name",
        "commit",
        "created",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^release/",
          "maxLength": 32
        },
        "commit": {
          "$ref": "release.schema.json#/$defs/commit"
        },
        "created": {
          "type": "boolean"
        },
        "at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "nextVersion": {
      "$ref": "release.schema.json#/properties/nextVersion"
    },
    "builds": {
      "type": "array",
      "maxItems": 4,
      "description": "release ブランチから上げたビルド（プラットフォームごとに、処理を終えた最新のもの）",
      "items": {
        "type": "object",
        "required": [
          "platform",
          "build"
        ],
        "additionalProperties": false,
        "properties": {
          "platform": {
            "$ref": "release.schema.json#/$defs/platform"
          },
          "build": {
            "$ref": "release.schema.json#/$defs/buildNumber"
          },
          "uploadedAt": {
            "$ref": "../common.schema.json#/$defs/timestamp"
          }
        }
      }
    },
    "whatsNew": {
      "type": [
        "object",
        "null"
      ],
      "description": "What's New の下書き（言語ごと）。drafts が空なら、App Store にまだ版が無い（初めての版は What's New を持たない）",
      "required": [
        "drafts",
        "draftedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "drafts": {
          "$ref": "#/$defs/localizedTexts"
        },
        "draftedAt": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "listing": {
      "type": [
        "object",
        "null"
      ],
      "description": "掲載文の案（Claude が、配信中の版の掲載文と前に配信した版からの変更をもとに、言語ごとに書いたもの）。current は配信中の版の掲載文（空なら初めての版で、案を書かない）、drafts は直す案（変える言語だけ。空なら変えない。言語は current にあるものだけ）、reason は案の理由（変えないなら、その理由）",
      "required": [
        "current",
        "drafts",
        "reason",
        "draftedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "current": {
          "$ref": "#/$defs/currentListingTexts"
        },
        "drafts": {
          "$ref": "#/$defs/listingTexts"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "draftedAt": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "appReview": {
      "type": [
        "object",
        "null"
      ],
      "description": "App Review の情報の案（掲載文の案と同じ Claude の下書きで書く）。current は配信中の版の App Review の情報、draft は直す案（無い欄は変えない。null なら変えない）、reason は案の理由。初めての版・App Review の情報を扱う前に書いた案は null",
      "required": [
        "current",
        "reason",
        "draftedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "current": {
          "$ref": "#/$defs/reviewInformation"
        },
        "draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/reviewInformation"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "draftedAt": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "screenshots": {
      "type": [
        "object",
        "null"
      ],
      "description": "App Store のスクショを撮って比べた結果。state は capturing（撮っている）・captured・failed（failure に理由。スクショを変えずに審査に出せる）・notConfigured（撮らない。撮り方が無い・人が撮らずに進むを選んだ。failure にわけを書くことがある。リポジトリに撮り方があれば retakeScreenshots で後から撮れる）。sets は撮った組（表示サイズ × 言語）で、shots の preview は差のある画面の見本（状態リポジトリ）、before は前回の App Store の画像の URL、area は変わった所（割合）、removed は前回の組にあって撮ったものより後ろの位置の数。skipped は App Store Connect にあるが撮らなかった表示サイズ。run は撮影のワークフローの実行（capture: actions）",
      "required": [
        "state",
        "startedAt",
        "sets",
        "skipped"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "capturing",
            "captured",
            "failed",
            "notConfigured"
          ]
        },
        "commit": {
          "anyOf": [
            {
              "$ref": "release.schema.json#/$defs/commit"
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "finishedAt": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "sets": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "required": [
              "displayType",
              "locale",
              "shots",
              "removed"
            ],
            "additionalProperties": false,
            "properties": {
              "displayType": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,59}$",
                "maxLength": 60
              },
              "locale": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8}){0,2}$",
                "maxLength": 21
              },
              "shots": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": [
                    "index",
                    "name",
                    "changed"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "changed": {
                      "type": "boolean"
                    },
                    "preview": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^repos/[^/]+/[^/]+/store-screenshots/",
                      "maxLength": 400
                    },
                    "before": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^https://",
                      "maxLength": 2000
                    },
                    "area": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "x",
                            "y",
                            "width",
                            "height"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "x": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "y": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "width": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "height": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "rejected": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1,
                      "maxLength": 1000,
                      "description": "App Store Connect のライブラリが受け付けなかったわけ（この画面は前のままにするしかない）"
                    }
                  }
                }
              },
              "removed": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "skipped": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "displayType",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "displayType": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,59}$",
                "maxLength": 60
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        "failure": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "run": {
          "type": [
            "object",
            "null"
          ],
          "description": "撮影のワークフローの実行（capture: actions のときだけ）。id は run の id（起動の応答か、起動した後の一覧で分かる）、url は run の画面、dispatchedAt は起動を送った時刻、status・conclusion は GitHub の run の様子と結論。after は起動の前からあった、ブランチの workflow_dispatch の run の最大の id（id の分からない run を一覧から探すとき、これより新しいものだけを候補にする）",
          "required": [
            "dispatchedAt"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "url": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^https://github\\.com/",
              "maxLength": 400
            },
            "dispatchedAt": {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            "status": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z_]{1,40}$"
            },
            "conclusion": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z_]{1,40}$"
            },
            "after": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "library": {
          "type": [
            "object",
            "null"
          ],
          "description": "撮って比べた画像を App Store Connect のライブラリに先に上げた様子（配置はしない）。total は上げた画像の数（同じ画像は 1 つ）、ready は置ける状態になった数、sentAt は上げ終えた時刻。すべて置ける（か受け付けられない）まで state は capturing のまま",
          "required": [
            "total",
            "ready",
            "sentAt"
          ],
          "additionalProperties": false,
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "ready": {
              "type": "integer",
              "minimum": 0
            },
            "sentAt": {
              "$ref": "../common.schema.json#/$defs/timestamp"
            }
          }
        },
        "retake": {
          "type": [
            "object",
            "null"
          ],
          "description": "人が頼んだ撮り直し（retakeScreenshots）。displayTypes・locales は撮り直す組（空ならすべて）、approval は頼んだ人の意図、at は受け付けた時刻、startedAt は司令塔が撮り直しを始めた時刻（まだなら null。その間は審査に出す準備をそろえない）、from は一部だけ撮り直すときに引き継ぐ組を撮ったコミット",
          "required": [
            "displayTypes",
            "locales",
            "approval",
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "displayTypes": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,59}$"
              }
            },
            "locales": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8}){0,2}$"
              }
            },
            "approval": {
              "$ref": "../common.schema.json#/$defs/intentReference"
            },
            "at": {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            "startedAt": {
              "anyOf": [
                {
                  "$ref": "../common.schema.json#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "from": {
              "anyOf": [
                {
                  "$ref": "release.schema.json#/$defs/commit"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "ビルド・What's New の下書き・掲載文の案が変わるたびに上げる。submitForReview の targetVersion"
    },
    "submit": {
      "type": [
        "object",
        "null"
      ],
      "description": "人が審査に出すを押した中身。司令塔が出し終えたら review に submittedAt が付く。取り下げを終えたら消す",
      "required": [
        "approval",
        "at",
        "builds",
        "whatsNew",
        "releaseType"
      ],
      "additionalProperties": false,
      "properties": {
        "approval": {
          "$ref": "../common.schema.json#/$defs/intentReference"
        },
        "at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "builds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/buildChoice"
          }
        },
        "whatsNew": {
          "$ref": "#/$defs/localizedTexts"
        },
        "releaseType": {
          "enum": [
            "afterApproval",
            "manual",
            "scheduled"
          ]
        },
        "earliestReleaseDate": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "listing": {
          "$ref": "#/$defs/listingTexts",
          "description": "人が確かめた掲載文の直し（変える言語だけ）。無ければ掲載文を扱う前に受け付けたもの"
        },
        "appReview": {
          "$ref": "#/$defs/reviewInformation",
          "description": "人が確かめた App Review の情報の直し（無い欄は変えない）。無ければ変えない"
        },
        "screenshots": {
          "$ref": "#/$defs/screenshotDecision",
          "description": "人が確かめたスクショ。無ければスクショを変えない"
        },
        "creative": {
          "$ref": "#/$defs/creativeChoice",
          "description": "載せるクリエイティブアセット。無ければ載せない"
        }
      }
    },
    "review": {
      "type": "array",
      "maxItems": 4,
      "description": "プラットフォームごとの審査の状態（司令塔が App Store Connect の appVersionState を読んだもの）",
      "items": {
        "type": "object",
        "required": [
          "platform",
          "state",
          "since"
        ],
        "additionalProperties": false,
        "properties": {
          "platform": {
            "$ref": "release.schema.json#/$defs/platform"
          },
          "state": {
            "enum": [
              "prepareForSubmission",
              "readyForReview",
              "waitingForReview",
              "inReview",
              "pendingDeveloperRelease",
              "pendingAppleRelease",
              "processingForDistribution",
              "readyForDistribution",
              "rejected",
              "metadataRejected",
              "developerRejected",
              "accepted",
              "invalidBinary",
              "waitingForExportCompliance",
              "replacedWithNewVersion"
            ]
          },
          "since": {
            "$ref": "../common.schema.json#/$defs/timestamp"
          },
          "submittedAt": {
            "anyOf": [
              {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "distribution": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "approval",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "approval": {
          "$ref": "../common.schema.json#/$defs/intentReference"
        },
        "at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "doneAt": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "人が配信するを押した（distributeRelease）。司令塔が App Store Connect に送ったら doneAt が付く"
    },
    "withdrawal": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "approval",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "approval": {
          "$ref": "../common.schema.json#/$defs/intentReference"
        },
        "at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "doneAt": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "人が審査の取り下げを押した（withdrawSubmission）。司令塔が取り下げたら doneAt が付く"
    },
    "rejections": {
      "description": "審査で断られたときの対処（断られた提出ごと。最後が今の対処）。AskHub で始めた記録だけ持つ",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejection"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "end": {
      "type": [
        "object",
        "null"
      ],
      "description": "終わりの印。distributed は配信を見つけた、abandoned は人がやめた、superseded はもっと新しい版を配信した",
      "required": [
        "reason",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "distributed",
            "abandoned",
            "superseded"
          ]
        },
        "at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/intentReference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "integration": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 4,
      "description": "配信した後に release ブランチを取り込んだ様子（main と base の develop）。open は PR を開いている、merged はマージした、skipped は取り込むコミットが無かった、created は main が無かったので release ブランチの先頭から作った。PR の番号は open・merged のときだけ持つ",
      "items": {
        "type": "object",
        "required": [
          "base",
          "state",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "base": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "state": {
            "enum": [
              "open",
              "merged",
              "skipped",
              "created"
            ]
          },
          "pullRequest": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "at": {
            "$ref": "../common.schema.json#/$defs/timestamp"
          }
        }
      }
    },
    "appStoreVersions": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 4,
      "description": "App Store Connect の版の枠（プラットフォームごと）。null なら枠を作らない（この仕組みの前に始めた記録）。startRelease を受け付けたときに空の並びで作り、司令塔が作った・見つけた編集できる版を足す。build は枠に選んだビルドの番号、whatsNew は下書きを各言語に書いたか、removal はやめたリリースの枠を消した結果（deleted・kept。kept なら removalNote に理由）",
      "items": {
        "type": "object",
        "required": [
          "platform",
          "id",
          "whatsNew",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "platform": {
            "$ref": "release.schema.json#/$defs/platform"
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$"
          },
          "build": {
            "anyOf": [
              {
                "$ref": "release.schema.json#/$defs/buildNumber"
              },
              {
                "type": "null"
              }
            ]
          },
          "whatsNew": {
            "type": "boolean"
          },
          "at": {
            "$ref": "../common.schema.json#/$defs/timestamp"
          },
          "removal": {
            "enum": [
              "deleted",
              "kept",
              null
            ]
          },
          "removalNote": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "problem": {
      "type": [
        "object",
        "null"
      ],
      "description": "進められなかった理由（進められたら消す）。needsHuman が true なら、やり直しても進まないので人が直す",
      "required": [
        "step",
        "message",
        "needsHuman",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "step": {
          "enum": [
            "branch",
            "nextVersion",
            "whatsNew",
            "builds",
            "submit",
            "distribute",
            "withdraw",
            "review",
            "integration",
            "appStoreVersion",
            "listing",
            "screenshots"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "needsHuman": {
          "type": "boolean"
        },
        "at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "createdAt": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    }
  }
}
