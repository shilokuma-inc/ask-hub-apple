{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shilokuma-inc/ask-hub-apple/protocol/schemas/state/repo.schema.json",
  "title": "repos/<owner>/<repo>/repo.json（対象のリポジトリの設定）",
  "description": "司令塔だけが書く",
  "type": "object",
  "required": ["v", "repo", "platform", "maxConcurrentEpics", "protection", "addedAt"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "repo": { "$ref": "../common.schema.json#/$defs/repositoryFullName" },
    "platform": { "enum": ["apple"] },
    "maxConcurrentEpics": { "type": "integer", "minimum": 1, "description": "同時に回す epic の上限（最初の版は 1）" },
    "appKit": {
      "description": "呼ぶ共通リポジトリの版。共通リポジトリのワークフローを入れる前は null",
      "anyOf": [
        {
          "type": "object",
          "required": ["ref"],
          "additionalProperties": false,
          "properties": { "ref": { "type": "string", "minLength": 1, "description": "固定したコミットか、保護したタグ" } }
        },
        { "type": "null" }
      ]
    },
    "protection": {
      "description": "ブランチの保護（ルールセット askhub-protect）。司令塔が applyProtection を処理して書き、掛けた後のずれを定期的に点検して drift に書く",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appliedAt": { "anyOf": [{ "$ref": "../common.schema.json#/$defs/timestamp" }, { "type": "null" }], "description": "人がクライアントで押して保護を設定した時刻" },
        "requiredChecks": {
          "anyOf": [{ "$ref": "../payloads/applyProtection.schema.json#/$defs/requiredChecks" }, { "type": "null" }],
          "description": "必須にしたチェックの名前（applyProtection の requiredChecks）"
        },
        "rulesetId": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }], "description": "掛けたルールセットの id" },
        "replaced": {
          "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/existingProtection" } }, { "type": "null" }],
          "description": "掛けたときに外した、develop・main・release/**（と既定のブランチ）に重なる保護"
        },
        "remaining": {
          "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/existingProtection" } }, { "type": "null" }],
          "description": "外せずに残った、重なる保護（organization のルールセット）"
        },
        "drift": {
          "description": "掛けた後のずれ。ずれていない・まだ確かめていなければ null",
          "anyOf": [
            {
              "type": "object",
              "required": ["foundAt", "problems"],
              "additionalProperties": false,
              "properties": {
                "foundAt": { "$ref": "../common.schema.json#/$defs/timestamp", "description": "今のずれを見つけた時刻（中身が変わったときだけ書き直す）" },
                "problems": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "description": "人が読むずれの説明" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "build": {
      "anyOf": [{ "$ref": "../repository-build.schema.json" }, { "type": "null" }],
      "description": "ビルドの設定（人が configureRepository で入れる）。無いリポジトリでは開始を断る"
    },
    "icon": {
      "description": "対象のアプリのアイコン（画像は repos/<owner>/<repo>/icon.png）。司令塔が対象のリポジトリの既定のブランチから取り出して書く。まだ取り出していない・見つからないなら null",
      "anyOf": [
        {
          "type": "object",
          "required": ["source", "sourceTree", "image", "updatedAt"],
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string", "minLength": 1, "maxLength": 1000, "description": "取り出した元（.icon か .appiconset のフォルダ）の、リポジトリの直下からのパス" },
            "sourceTree": { "type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40, "description": "元のフォルダの git の tree の sha。変わったときだけ書き出し直す" },
            "image": { "type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40, "description": "書いた画像（PNG）の git の blob の sha。クライアントはこれを鍵に画像をしまっておく" },
            "updatedAt": { "$ref": "../common.schema.json#/$defs/timestamp" }
          }
        },
        { "type": "null" }
      ]
    },
    "setup": {
      "description": "対象に加えるときの GitHub 側の準備の結果。司令塔が addRepository を処理したとき（加え直したときも）に、管理用のトークンで流して書く。まだ流していなければ null",
      "anyOf": [
        {
          "type": "object",
          "required": ["updatedAt"],
          "additionalProperties": false,
          "properties": {
            "updatedAt": { "$ref": "../common.schema.json#/$defs/timestamp" },
            "discussions": {
              "anyOf": [{ "enum": ["ready", "missingCategory", "unknown"] }, { "type": "null" }],
              "description": "ready は Discussions が有効でカテゴリ Ideas がある、missingCategory は Ideas が無い（人が作る）、unknown は有効にできない・確かめられない（理由は problems）"
            },
            "workflows": {
              "description": "ワークフローを直す、決まった手順の PR。確かめられなかったら null",
              "anyOf": [
                {
                  "type": "object",
                  "required": ["state", "changes"],
                  "additionalProperties": false,
                  "properties": {
                    "state": { "enum": ["notNeeded", "open", "merged", "closed"] },
                    "pullRequest": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
                    "head": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40 }, { "type": "null" }], "description": "PR を出したときの head。承認（approveSetupPullRequest）はこれに結びつく" },
                    "changes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["kind", "path"],
                        "additionalProperties": false,
                        "properties": {
                          "kind": { "enum": ["removeLegacy", "removePathFilters"] },
                          "path": { "type": "string", "minLength": 1, "maxLength": 1000 }
                        }
                      }
                    }
                  }
                },
                { "type": "null" }
              ]
            },
            "problems": {
              "anyOf": [{ "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }, { "type": "null" }],
              "description": "準備を止めた・できなかった理由（人が読む文。管理用のトークンが無い など）"
            }
          }
        },
        { "type": "null" }
      ]
    },
    "addedAt": { "$ref": "../common.schema.json#/$defs/timestamp" },
    "removedAt": {
      "anyOf": [{ "$ref": "../common.schema.json#/$defs/timestamp" }, { "type": "null" }],
      "description": "対象から外した時刻（removeRepository）。外していなければ省くか null。加え直すと外す"
    }
  },
  "$defs": {
    "existingProtection": {
      "type": "object",
      "required": ["kind", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["classic", "ruleset", "organizationRuleset"], "description": "classic はクラシックのブランチ保護（name はパターン）、ruleset はリポジトリのルールセット、organizationRuleset は organization のルールセット" },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    }
  }
}
