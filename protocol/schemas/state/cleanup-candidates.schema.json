{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shilokuma-inc/ask-hub-apple/protocol/schemas/state/cleanup-candidates.schema.json",
  "title": "cleanup/<mac>/candidates.json（片付けの候補と、頼みを済ませた記録）",
  "description": "その Mac のワーカーだけが書く。候補は、ワーカーが作っていないもの（人が作った clone・Simulator・Xcode の DerivedData）。消すのは、人が選んで消す意図を送ったものだけ",
  "type": "object",
  "required": ["v", "mac", "candidates", "handled"],
  "additionalProperties": false,
  "$defs": {
    "candidateId": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
  },
  "properties": {
    "v": { "const": 1 },
    "mac": { "$ref": "../common.schema.json#/$defs/macName" },
    "scannedAt": { "$ref": "../common.schema.json#/$defs/timestamp", "description": "最後に探し終えた時刻。まだ探していなければ書かない" },
    "candidates": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "location", "bytes"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/candidateId" },
          "kind": { "enum": ["clone", "simulator", "derivedData"] },
          "name": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1, "description": "clone と DerivedData はホームからのパス（~/…）、Simulator は UDID" },
          "bytes": { "type": "integer", "minimum": 0 },
          "lastUsedAt": { "$ref": "../common.schema.json#/$defs/timestamp" },
          "caution": { "type": "string", "minLength": 1, "description": "消せない理由（未コミット・未 push・stash・起動中など）。あれば消さない" }
        }
      }
    },
    "unreadable": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "探せなかった場所（ホームからのパス）" },
    "handled": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["intent", "action", "at"],
        "additionalProperties": false,
        "properties": {
          "intent": { "$ref": "../common.schema.json#/$defs/intentReference" },
          "action": { "enum": ["find", "remove"] },
          "at": { "$ref": "../common.schema.json#/$defs/timestamp" },
          "removed": { "type": "array", "items": { "$ref": "#/$defs/candidateId" } },
          "skipped": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "reason"],
              "additionalProperties": false,
              "properties": { "id": { "$ref": "#/$defs/candidateId" }, "reason": { "type": "string", "minLength": 1 } }
            }
          },
          "problem": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
