{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shilokuma-inc/ask-hub-apple/protocol/schemas/payloads/reportRejection.schema.json",
  "title": "リジェクトの理由を貼る人の意図（kind が reportRejection）の payload",
  "description": "封筒の target は {type: submission, id: <版>}。targetVersion は書かない。text は App Store Connect で見た審査の文、attachments は画面の画像（依頼の添付と同じ形・同じ置き場所 attachments/<device>/<nonce>/<n>）。どちらかは要る（空白だけの text は無いとみなす）。知らない欄のある payload は読まない",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "maxLength": 10000
    },
    "attachments": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "n",
          "name",
          "size",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 52428800
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
