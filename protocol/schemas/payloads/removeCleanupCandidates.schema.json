{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shilokuma-inc/ask-hub-apple/protocol/schemas/payloads/removeCleanupCandidates.schema.json",
  "title": "選んだ片付けの候補を消す人の意図（kind が removeCleanupCandidates）の payload",
  "description": "封筒の repo・target・targetVersion は書かない。mac は消す Mac、scannedAt は選んだ候補を探した時刻（cleanup/<mac>/candidates.json の scannedAt）、candidates は消す候補の id。ワーカーは自分が探して書いた候補だけを消す。知らない欄のある payload は読まない",
  "type": "object",
  "required": ["mac", "scannedAt", "candidates"],
  "additionalProperties": false,
  "properties": {
    "mac": { "$ref": "../common.schema.json#/$defs/macName" },
    "scannedAt": { "$ref": "../common.schema.json#/$defs/timestamp" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "$ref": "../state/cleanup-candidates.schema.json#/$defs/candidateId" }
    }
  }
}
